    &HEAD CHID='candle_fine_nest15_mpi', TITLE='candle compartment -- 1 candle(s), near-fire dx=1.5 mm, SEALED box' /

    ! ============================================================
    !  MESH  --  D* = 1.21 cm for a 18 W fire
    !  near-fire dx = 1.5 mm  ->  D*/dx = 8.1
    !  (FDS convention wants ~10-16; a 18 W candle plume is near the
    !   lower edge of FDS's validated envelope -- this is a KNOWN weak point,
    !   quantified by the P04 mesh study, not hidden.)
    ! ============================================================
    &MESH ID='outer_000', MPI_PROCESS=0, IJK=167,50,84, XB=0.0000,1.0020,0.0000,0.3000,0.0000,0.5040 / outer dx=6.00mm
&MESH ID='core_000', MPI_PROCESS=1, IJK=112,64,24, XB=0.0000,0.1680,0.1020,0.1980,0.0000,0.0360 / core dx=1.50mm
&MESH ID='core_001', MPI_PROCESS=2, IJK=112,64,24, XB=0.0000,0.1680,0.1020,0.1980,0.0360,0.0720 / core dx=1.50mm
&MESH ID='core_002', MPI_PROCESS=3, IJK=112,64,28, XB=0.0000,0.1680,0.1020,0.1980,0.0720,0.1140 / core dx=1.50mm
&MESH ID='core_003', MPI_PROCESS=4, IJK=112,64,28, XB=0.0000,0.1680,0.1020,0.1980,0.1140,0.1560 / core dx=1.50mm
&MESH ID='core_004', MPI_PROCESS=5, IJK=112,64,28, XB=0.0000,0.1680,0.1020,0.1980,0.1560,0.1980 / core dx=1.50mm
&MESH ID='core_005', MPI_PROCESS=6, IJK=112,64,28, XB=0.0000,0.1680,0.1020,0.1980,0.1980,0.2400 / core dx=1.50mm
! 7 meshes / MPI ranks total  (outer 1 @ 6mm + core 6 @ 1.50mm)

    &TIME T_END=150.0 /
    &MISC TMPA=25.0 /           ! exponat R1 pre-ignition TC median ~25 C
    &DUMP DT_DEVC=1.0, DT_HRR=1.0, DT_SLCF=5.0, DT_BNDF=10.0, SIG_FIGS=6 /

    ! ============================================================
    !  COMBUSTION  --  source term from CONE_FINDINGS.md (NOT calibrated here)
    !  18 W per candle (measured band 16-20 W; total source uncertainty +-15-20%)
    !  paraffin, clean flame (cone soot ~ 0), constant HRR (balance mass-loss
    !  linear to r^2 > 0.999) with a 25 s ignition ramp.
    !  NOTE: fuel composition goes ON THE REAC (FORMULA=). A standalone
    !  &SPEC ID='PARAFFIN' PLUS &REAC FUEL='PARAFFIN' double-declares the species
    !  and corrupts the species setup in FDS 6.11.x (malloc: corrupted top size,
    !  confirmed on Pleiades). FDS defines the fuel species from FORMULA itself.
    ! ============================================================
    &REAC FUEL='PARAFFIN', FORMULA='C25H52', SOOT_YIELD=0.008, CO_YIELD=0.001,
          HEAT_OF_COMBUSTION=42000, RADIATIVE_FRACTION=0.25 /

    &SURF ID='CANDLE_FLAME', HRRPUA=13.89, TAU_Q=-25.0, COLOR='ORANGE' /
    ! HRRPUA 13.89 kW/m2 x 12.96 cm2 = 18.0 W per candle
    ! (target cup area 10.8 cm2 = 37 mm circle; grid-snapped square = 12.96 cm2)

    ! &PROP ID='TCbead', EMISSIVITY=0.85, DIAMETER=0.001 /  ! for the optional _bead DEVCs; FDS >= ~6.7.4

    ! ============================================================
    !  WALLS  --  10 mm acrylic/PMMA, NOT inert (matters for a long low-power burn)
    !  k=0.19 W/mK, rho=1180, c=1.47 kJ/kgK, eps=0.9  (standard cast PMMA)
    !  BACKING='EXPOSED' -> outer face loses heat to lab air at TMPA
    ! ============================================================
    &MATL ID='PMMA', CONDUCTIVITY=0.19, SPECIFIC_HEAT=1.47, DENSITY=1180.0, EMISSIVITY=0.90 /
    &SURF ID='ACRYLIC_WALL', MATL_ID='PMMA', THICKNESS=0.010, BACKING='EXPOSED',
          COLOR='SKY BLUE', TRANSPARENCY=0.2 /

    ! ---- SEALED outer box: every domain face is closed acrylic (user correction) ----
    &VENT MB='XMIN', SURF_ID='ACRYLIC_WALL' /
    &VENT MB='XMAX', SURF_ID='ACRYLIC_WALL' /
    &VENT MB='YMIN', SURF_ID='ACRYLIC_WALL' /
    &VENT MB='YMAX', SURF_ID='ACRYLIC_WALL' /
    &VENT MB='ZMIN', SURF_ID='ACRYLIC_WALL' /
    &VENT MB='ZMAX', SURF_ID='ACRYLIC_WALL' /

    ! ============================================================
    !  ROOM  --  0-0.70 x, full depth, 0-0.23 z; 10 mm acrylic walls
    !  (room spans the full box depth, so its side walls ARE the box side walls;
    !   its back wall IS the box XMIN face -- only ceiling + doorway wall are OBSTs)
    ! ============================================================
    &OBST XB=0.000,0.710, 0.000,0.300, 0.230,0.240, SURF_ID='ACRYLIC_WALL', TRANSPARENCY=0.2 / room ceiling
    &OBST XB=0.700,0.710, 0.000,0.300, 0.000,0.230, SURF_ID='ACRYLIC_WALL', TRANSPARENCY=0.2 / doorway wall
    &HOLE XB=0.694,0.716, 0.125,0.175, -0.001,0.150 / doorway 0.05 w x 0.15 h, depth-centred

    ! ============================================================
    !  FIRE
    ! ============================================================
    &OBST XB=0.0720,0.1080,0.1320,0.1680,0.0000,0.0060, SURF_ID='INERT', COLOR='GRAY' / candle 1 cup rim
&VENT XB=0.0720,0.1080,0.1320,0.1680,0.0060,0.0060, SURF_ID='CANDLE_FLAME', COLOR='RED' / candle 1 burner top (13.0 cm2, z=6 mm)

    ! ============================================================
    !  DEVICES  --  7 experimental TCs: modelled bead ('T1'..) + gas temp ('T1_gas'..)
    !  Names match the experiment 1:1 for P05 pairing.
    ! ============================================================
    &DEVC ID='T1',      XYZ=0.120,0.150,0.050, QUANTITY='TEMPERATURE' /
! &DEVC ID='T1_bead', XYZ=0.120,0.150,0.050, QUANTITY='THERMOCOUPLE', PROP_ID='TCbead' /
&DEVC ID='T2',      XYZ=0.120,0.150,0.160, QUANTITY='TEMPERATURE' /
! &DEVC ID='T2_bead', XYZ=0.120,0.150,0.160, QUANTITY='THERMOCOUPLE', PROP_ID='TCbead' /
&DEVC ID='T3',      XYZ=0.120,0.150,0.225, QUANTITY='TEMPERATURE' /
! &DEVC ID='T3_bead', XYZ=0.120,0.150,0.225, QUANTITY='THERMOCOUPLE', PROP_ID='TCbead' /
&DEVC ID='T5',      XYZ=0.350,0.150,0.225, QUANTITY='TEMPERATURE' /
! &DEVC ID='T5_bead', XYZ=0.350,0.150,0.225, QUANTITY='THERMOCOUPLE', PROP_ID='TCbead' /
&DEVC ID='T9',      XYZ=0.700,0.150,0.015, QUANTITY='TEMPERATURE' /
! &DEVC ID='T9_bead', XYZ=0.700,0.150,0.015, QUANTITY='THERMOCOUPLE', PROP_ID='TCbead' /
&DEVC ID='T10',      XYZ=0.700,0.150,0.075, QUANTITY='TEMPERATURE' /
! &DEVC ID='T10_bead', XYZ=0.700,0.150,0.075, QUANTITY='THERMOCOUPLE', PROP_ID='TCbead' /
&DEVC ID='T11',      XYZ=0.700,0.150,0.140, QUANTITY='TEMPERATURE' /
! &DEVC ID='T11_bead', XYZ=0.700,0.150,0.140, QUANTITY='THERMOCOUPLE', PROP_ID='TCbead' /

&DEVC ID='rk_x075_z020', XYZ=0.075,0.150,0.020, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x075_z035', XYZ=0.075,0.150,0.035, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x075_z050', XYZ=0.075,0.150,0.050, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x075_z070', XYZ=0.075,0.150,0.070, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x075_z100', XYZ=0.075,0.150,0.100, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x090_z020', XYZ=0.090,0.150,0.020, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x090_z035', XYZ=0.090,0.150,0.035, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x090_z050', XYZ=0.090,0.150,0.050, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x090_z070', XYZ=0.090,0.150,0.070, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x090_z100', XYZ=0.090,0.150,0.100, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x105_z020', XYZ=0.105,0.150,0.020, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x105_z035', XYZ=0.105,0.150,0.035, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x105_z050', XYZ=0.105,0.150,0.050, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x105_z070', XYZ=0.105,0.150,0.070, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x105_z100', XYZ=0.105,0.150,0.100, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x120_z020', XYZ=0.120,0.150,0.020, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x120_z035', XYZ=0.120,0.150,0.035, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x120_z050', XYZ=0.120,0.150,0.050, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x120_z070', XYZ=0.120,0.150,0.070, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x120_z100', XYZ=0.120,0.150,0.100, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x135_z020', XYZ=0.135,0.150,0.020, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x135_z035', XYZ=0.135,0.150,0.035, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x135_z050', XYZ=0.135,0.150,0.050, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x135_z070', XYZ=0.135,0.150,0.070, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x135_z100', XYZ=0.135,0.150,0.100, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x150_z020', XYZ=0.150,0.150,0.020, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x150_z035', XYZ=0.150,0.150,0.035, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x150_z050', XYZ=0.150,0.150,0.050, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x150_z070', XYZ=0.150,0.150,0.070, QUANTITY='TEMPERATURE' /
&DEVC ID='rk_x150_z100', XYZ=0.150,0.150,0.100, QUANTITY='TEMPERATURE' /
&DEVC ID='Tmax_core', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAX', XB=0.000,0.168,0.102,0.198,0.000,0.240 /
&DEVC ID='Tmax_T1cell', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAX', XB=0.09,0.15,0.14,0.16,0.03,0.07 /  ! peak T in the T1 neighbourhood
    &DEVC ID='HRR', QUANTITY='HRR', SPATIAL_STATISTIC='VOLUME INTEGRAL', XB=0.00,1.00,0.00,0.30,0.00,0.50 /
    &DEVC ID='O2_room', QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN', XYZ=0.35,0.15,0.115 /
    &DEVC ID='p_box',  QUANTITY='PRESSURE', XYZ=0.50,0.15,0.40 /

    ! ---- Phase-4 smoke tracer (DORMANT: no source until P04/P05 adds MASS_FLUX
    !      to the candle rim). Kept here so the SPEC id is stable. ----
    ! &SPEC ID='TRACER', MASS_FRACTION_0=0.0 /
    ! &DEVC ID='tracer_T3', QUANTITY='MASS FRACTION', SPEC_ID='TRACER', XYZ=0.12,0.15,0.225 /

    ! ============================================================
    !  OUTPUT  --  lean: centre-plane temperature + velocity, wall temp
    !  (fine runs add HRRPUV + a plane through the column probes -- see below)
    ! ============================================================
    &SLCF PBY=0.15, QUANTITY='TEMPERATURE', CELL_CENTERED=.TRUE. /
    &SLCF PBY=0.15, QUANTITY='VELOCITY', VECTOR=.TRUE. /
    &SLCF PBY=0.15, QUANTITY='HRRPUV', CELL_CENTERED=.TRUE. /
    &SLCF PBX=0.12, QUANTITY='TEMPERATURE', CELL_CENTERED=.TRUE. /  ! plane through the column probes
    &BNDF QUANTITY='WALL TEMPERATURE' /

    &TAIL /
