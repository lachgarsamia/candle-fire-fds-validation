&MESH ID='core_000', MPI_PROCESS=48, IJK=168,100,36, XB=0.0000,0.1680,0.1000,0.2000,0.0000,0.0360 / core dx=1.00mm
&MESH ID='core_001', MPI_PROCESS=49, IJK=168,100,36, XB=0.0000,0.1680,0.1000,0.2000,0.0360,0.0720 / core dx=1.00mm
